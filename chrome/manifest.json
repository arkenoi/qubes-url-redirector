{
    "manifest_version": 3,
    "name": "Open in Qube",
    "version": "3.1.0",
    "key": "",
    "minimum_chrome_version": "111",
    "description": "Redirect blacklisted URLs to another qube while you surf the web!",
    "icons": {
        "16": "common/logo.png",
        "32": "common/logo.png",
        "48": "common/logo.png",
        "64": "common/logo.png",
        "128": "common/logo.png"
    },
    "author": "Raffaele Florio",
    "homepage_url": "https://github.com/arkenoi/qubes-url-redirector",
    "options_ui": {
        "page": "common/html/settings.html",
        "open_in_tab": true
    },
    "action": {
        "default_popup": "common/html/req_popup.html",
        "default_title": "Blocked resources in this tab",
        "default_icon": "common/logo_disabled.png"
    },
    "background": {
        "service_worker": "sw.js"
    },
    "permissions": [
        "contextMenus",
        "storage",
        "nativeMessaging",
        "declarativeNetRequest",
        "webRequest",
        "tabs"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "common/html/firewall.html"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}
